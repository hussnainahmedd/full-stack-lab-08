        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 (Created)\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"class-transformer trimmed, upper-cased and lower-cased the values\", function () {",
              "  const s = pm.response.json();",
              "  pm.expect(s.name).to.eql(\"Zara Ali\");",
              "  pm.expect(s.rollNumber).to.eql(\"BSCS-099\");",
              "  pm.expect(s.email).to.eql(\"zara@example.com\");",
              "  pm.expect(s.status).to.eql(\"Excellent\");",
              "});",
              "pm.collectionVariables.set(\"newRoll\", pm.response.json().rollNumber);"
            ]
          }
        }
      ],
