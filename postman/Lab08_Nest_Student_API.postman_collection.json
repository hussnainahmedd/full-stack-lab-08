          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 (OK)\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Only the best Data Science student is returned\", function () {",
              "  const d = pm.response.json();",
              "  pm.expect(d.length).to.eql(1);",
              "  pm.expect(d[0].rollNumber).to.eql(\"BSCS-050\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
