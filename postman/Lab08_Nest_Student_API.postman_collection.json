{
  "info": {
    "name": "CS-301L Lab 08 - NestJS Student API",
    "description": "Tests for the Lab 08 NestJS API: dependency injection, DTOs and ValidationPipe. Start the server (npm run start:dev) and run the whole collection with the Collection Runner. It cleans up after itself, so it can be re-run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET all students",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 (OK)\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Six students, each with a status\", function () {",
              "  const d = pm.response.json();",
              "  pm.expect(d.length).to.eql(6);",
              "  d.forEach(function (s) { pm.expect(s).to.have.property(\"status\"); });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        }
      }
    },
    {
      "name": "2. GET statistics",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 (OK)\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Statistics are correct\", function () {",
              "  const s = pm.response.json();",
              "  pm.expect(s.totalStudents).to.eql(6);",
              "  pm.expect(s.averageCgpa).to.eql(3.02);",
              "  pm.expect(s.highest.name).to.eql(\"Sara Ahmed\");",
              "});"
            ]
          }
        }
      ],
